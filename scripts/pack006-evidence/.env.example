# PACK-006 database evidence — names only. Never commit real values.
# Copy to .env.local (gitignored) and fill for local Supabase OR an approved
# non-production disposable Supabase project.
#
# NEVER point these at production.

# Required acknowledgement (must be the literal string true)
PACK006_NON_PRODUCTION_CONFIRMED=

# Target mode: local | remote
PACK006_TARGET=

# Supabase project (local default URL http://127.0.0.1:54321)
PACK006_SUPABASE_URL=

# For local: prefer JWT keys from `npx supabase status -o env`:
#   ANON_KEY → PACK006_SUPABASE_ANON_KEY
#   SERVICE_ROLE_KEY → PACK006_SUPABASE_SERVICE_ROLE_KEY
# Stale sb_publishable / sb_secret values are often treated as anon by PostgREST.
# Local default: overlay status JWTs unless set to false.
PACK006_USE_SUPABASE_STATUS_KEYS=true

PACK006_SUPABASE_ANON_KEY=

# Server-only secret for bucket/admin fixtures/cleanup — NEVER NEXT_PUBLIC_*
PACK006_SUPABASE_SERVICE_ROLE_KEY=

# Optional project ref check (remote). Preflight fails if set and mismatched.
PACK006_SUPABASE_PROJECT_REF=

# Private Storage bucket (default transport-order-pdfs)
PACK006_PRIVATE_BUCKET=transport-order-pdfs

# Auth test users (app_metadata.role must match)
PACK006_ADMIN_EMAIL=
PACK006_ADMIN_PASSWORD=
PACK006_MANAGER_EMAIL=
PACK006_MANAGER_PASSWORD=
PACK006_VIEWER_EMAIL=
PACK006_VIEWER_PASSWORD=

# Required before ANY destructive remote operation (db reset / wipe).
# Local supabase db reset does not need this; remote wipe/push-reset does.
PACK006_ALLOW_DESTRUCTIVE_TEST_PROJECT_RESET=

# Optional run namespace for cleanup tagging
PACK006_RUN_ID=
