# Environment example — FUR-001
# Never put real secrets here.
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FROTCOM_BASE_URL=
FROTCOM_CLIENT_ID=
FROTCOM_CLIENT_SECRET=
FROTCOM_USERNAME=
FROTCOM_PASSWORD=
BUSINESS_TIMEZONE=Europe/Berlin

# PACK-006 persistence (default supabase). Memory requires BOTH flags for tests only.
# TRANSPORT_ORDER_STORE=supabase
# TRANSPORT_ORDER_ALLOW_MEMORY_STORE=1

# ---------------------------------------------------------------------------
# PACK-006 extraction providers
# See docs/LIVE-AI-PROVIDER-SETUP.md and docs/GEMINI-FREE-TIER-PILOT-CHECKLIST.md
#
# For normal development keep TRANSPORT_ORDER_PROVIDER=mock
# For Gemini free-tier pilot set TRANSPORT_ORDER_PROVIDER=gemini only in local .env.local
# If Grok/Qwen keys are not configured, keep fallback as manual
# Never use NEXT_PUBLIC_* for provider keys
# Never commit .env.local
# ---------------------------------------------------------------------------
TRANSPORT_ORDER_PROVIDER=mock
TRANSPORT_ORDER_FALLBACK_PROVIDERS=manual

# Gemini — SERVER ONLY (no NEXT_PUBLIC_*)
# GEMINI_MODEL_ID is canonical (exact id from Google AI Studio).
# Legacy GEMINI_MODEL is accepted only when GEMINI_MODEL_ID is unset/blank.
GEMINI_API_KEY=
GEMINI_MODEL_ID=
# GEMINI_MODEL=
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional providers — not used in free-tier pilot unless separately approved
# GROK_API_KEY=
# XAI_API_KEY=
# GROK_MODEL=grok-2-latest
# GROK_API_BASE_URL=https://api.x.ai/v1

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# QWEN_API_KEY=
# QWEN_MODEL=qwen-vl-max
# QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ---------------------------------------------------------------------------
# PACK-007 Google Directions API (server-only — never NEXT_PUBLIC_*)
# See docs/MAPS-API-SETUP.md
#
# MAPS_API_KEY: Get from Google Cloud Console (Directions API)
# MAPS_API_ENABLED: Set to true to enable live API calls
# MAPS_API_MONTHLY_BUDGET: Monthly budget in USD
# MAPS_API_WARNING_THRESHOLD: Warning threshold in percent
# For development, keep MAPS_API_ENABLED=false
# Never commit .env.local
# ---------------------------------------------------------------------------
MAPS_API_KEY=
MAPS_API_ENABLED=false
MAPS_API_MONTHLY_BUDGET=50
MAPS_API_WARNING_THRESHOLD=80
